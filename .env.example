# Backend Configuration
ENVIRONMENT=development
GOOGLE_CLOUD_PROJECT=typing-master-dev
JWT_SECRET=  # REQUIRED: Generate a strong random secret for production (e.g., openssl rand -base64 32). The application will fail to start without this.
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001  # REQUIRED: Comma-separated list of allowed CORS origins. The application will fail to start without this.
CACHE_MAX_SIZE=10000
CACHE_TTL_MINUTES=30

# Database: GCloud SQL (PostgreSQL) connection string
# Example: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Cache: Redis connection string
# Example: redis://host:6379 or redis://user:password@host:6379
REDIS_URL=

# Optional: Database connection pool settings
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME_MINUTES=30

# Optional: Redis pool settings
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080/api/v1
REACT_APP_ENVIRONMENT=development